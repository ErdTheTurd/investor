{
  "name": "dunn-investing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "cp index.source.html index.html",
    "dev": "vite",
    "prebuild": "cp index.source.html index.html",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build && rm -rf assets && cp -r dist/assets assets && cp dist/index.html index.html && cp dist/index.html 404.html && cp dist/favicon.svg favicon.svg 2>/dev/null || cp public/favicon.svg favicon.svg",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
